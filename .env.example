# Copy to .env and adjust. .env is gitignored; this file is committed.
#
#   cp .env.example .env
#
# Every variable is prefixed MCT_ and nested sections use a double underscore:
#   MCT_<SECTION>__<FIELD>=value
#
# Everything here is optional except where noted -- the application starts with
# no .env at all. Values shown are the built-in defaults unless marked otherwise.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# local | test | staging | production
MCT_ENVIRONMENT=local
# Human-readable console logs instead of JSON. Rejected when ENVIRONMENT=production.
MCT_DEBUG=true
# DEBUG | INFO | WARNING | ERROR | CRITICAL
MCT_LOG_LEVEL=INFO
# Override the thresholds file location. Defaults to <repo>/config/thresholds.yaml.
# MCT_THRESHOLDS_FILE=config/thresholds.yaml

# ---------------------------------------------------------------------------
# Database -- must match docker-compose.yml when using the local stack
# ---------------------------------------------------------------------------
MCT_DATABASE__HOST=localhost
MCT_DATABASE__PORT=5432
MCT_DATABASE__USER=postgres
# REQUIRED for any real deployment. Has no default: the empty default exists so
# a fresh clone starts, not so production runs without a password.
MCT_DATABASE__PASSWORD=postgres
MCT_DATABASE__DBNAME=multicam
MCT_DATABASE__POOL_SIZE=5
MCT_DATABASE__POOL_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
MCT_STORAGE__THUMBNAIL_DIR=storage/thumbnails
MCT_STORAGE__MEDIA_DIR=storage/media

# ---------------------------------------------------------------------------
# Vision (stages 11-13) -- ignored until the vision extra is installed
# ---------------------------------------------------------------------------
MCT_VISION__VEHICLE_DETECTOR_PATH=weights/vehicle_detector.pt
MCT_VISION__PLATE_DETECTOR_PATH=weights/plate_detector.pt
MCT_VISION__REID_MODEL_PATH=weights/reid_osnet.pt
MCT_VISION__EMBEDDING_DIM=512
# cpu | cuda
MCT_VISION__DEVICE=cpu
MCT_VISION__FRAME_SAMPLE_RATE_FPS=3.0
MCT_VISION__DETECTION_MIN_CONFIDENCE=0.25

# ---------------------------------------------------------------------------
# Thresholds -- normally left to config/thresholds.yaml. Uncomment to override
# a single value for this environment only.
# ---------------------------------------------------------------------------
# MCT_THRESHOLDS__PLATE_AUTO_ACCEPT_MIN_CONFIDENCE=0.85
# MCT_THRESHOLDS__PLATE_FUZZY_MAX_EDIT_DISTANCE=2
# MCT_THRESHOLDS__EMBEDDING_AUTO_ACCEPT_MIN_SIMILARITY=0.92
# MCT_THRESHOLDS__EMBEDDING_REVIEW_MIN_SIMILARITY=0.75
# MCT_THRESHOLDS__HOP_IMPLAUSIBLE_PENALTY=0.5

# ---------------------------------------------------------------------------
# Retention (governance requirement -- purge job lands in stage 18)
# ---------------------------------------------------------------------------
MCT_RETENTION__SIGHTING_TTL_DAYS=90
# Must be <= SIGHTING_TTL_DAYS, else the purge leaves orphaned thumbnails.
MCT_RETENTION__THUMBNAIL_TTL_DAYS=30
MCT_RETENTION__PURGE_ENABLED=true

# ---------------------------------------------------------------------------
# API (stage 16)
# ---------------------------------------------------------------------------
MCT_API__HOST=127.0.0.1
MCT_API__PORT=8000
# Defaults to false so a fresh clone runs. MUST be true anywhere real, and is
# forced true when ENVIRONMENT=production.
MCT_API__AUTH_ENABLED=false
# REQUIRED when AUTH_ENABLED=true. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCT_API__SECRET_KEY=
MCT_API__ACCESS_TOKEN_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Topology (stage 04)
#
# The SPEED MODEL used to derive travel times is not here -- it lives in the
# `defaults` block of config/topology.yaml, because it describes one particular
# road network. What lives here is how this deployment queries the graph.
# ---------------------------------------------------------------------------
MCT_TOPOLOGY__TOPOLOGY_FILE=config/topology.yaml
# Implied speed above which a link is warned about (not rejected).
MCT_TOPOLOGY__IMPLAUSIBLE_SPEED_KPH=200.0
# Below this gap, two sightings on one camera are one pass, not two transits.
MCT_TOPOLOGY__MIN_REDETECTION_GAP_SEC=60.0
# Seconds outside a travel window at which the plausibility score halves.
MCT_TOPOLOGY__PLAUSIBILITY_DECAY_HALF_LIFE_SEC=120.0
# Score for a camera pair the topology does not connect. Non-zero on purpose:
# an undeclared route is unexplained, not impossible.
MCT_TOPOLOGY__UNLINKED_PLAUSIBILITY_SCORE=0.1
# Expansion cap for multi-hop reachability; results are flagged truncated.
MCT_TOPOLOGY__MAX_VISITED_NODES=10000
